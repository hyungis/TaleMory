# Secrets and local environment files
.env
.env.*
**/.env
**/.env.*
*.local
*.secret
*.secrets
docs/plans/

# Keep shareable examples tracked
!.env.example
!**/.env.example

# infra/env/ runtime files (local/production values). Only *.example commits.
infra/env/*.env
!infra/env/*.env.example

# Private keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# OS/editor noise at repo root
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code per-session cache
.claude/cache/
**/.claude/cache/

# Claude Code worktrees (local, ephemeral)
.claude/worktrees/
**/.claude/worktrees/

# Python local artifacts
**/.venv/
**/__pycache__/
*.pyc
*.pyo

.omc
**/.omc