# Secrets and local environment files
.env
.env.*
**/.env
**/.env.*
*.local
*.secret
*.secrets
docs/plans/

# infra/env/ runtime files (local values). Only *.example commits.
# (로컬 개발 진입점은 `docker compose -f infra/compose/docker-compose.app-local.yml ...`;
#  루트 .env는 더 이상 사용하지 않음.)
infra/env/*.env
!infra/env/*.env.example

# Private keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx

# OS/editor noise at repo root
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code per-session cache
.claude/cache/
**/.claude/cache/

# Claude Code worktrees (local, ephemeral)
.claude/worktrees/
**/.claude/worktrees/

# Claude Code per-developer overrides (permissions/allowlist은 개인별)
.claude/settings.local.json
**/.claude/settings.local.json

# Python local artifacts
**/.venv/
**/__pycache__/
*.pyc
*.pyo

.omc
**/.omc

.omx
**/.omx