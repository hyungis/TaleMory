# Local AI service settings
PROJECT_NAME=S210 AI API
APP_VERSION=0.1.0
ENVIRONMENT=local

# Storyboard generation
# Use gpt-4o-mini by default for cost-effective MVP testing.
# Set to gpt-4o when you want higher quality story generation.
STORYBOARD_MODEL=gpt-4o-mini
STORYBOARD_INPUT_COST_PER_1M=0.15
STORYBOARD_OUTPUT_COST_PER_1M=0.60

# Leave empty to use the local deterministic fallback.
# Set this to call OpenAI from /internal/storyboards/generate.
OPENAI_API_KEY=
COSYVOICE_BASE_URL=http://localhost:8001
COSYVOICE_INSTRUCT_PATH=/inference_instruct2
COSYVOICE_CROSS_LINGUAL_PATH=/inference_cross_lingual
COSYVOICE_ZERO_SHOT_PATH=/inference_zero_shot
COSYVOICE_TIMEOUT_SEC=60
TTS_STORAGE_MODE=local
TTS_PUBLIC_BASE_URL=/static
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_PREFIX=stories/tts
AWS_S3_PUBLIC_BASE_URL=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=rabbitpass
RABBITMQ_VHOST=/
RABBITMQ_REQUEST_EXCHANGE=storyboard.request
RABBITMQ_RESULT_EXCHANGE=storyboard.result
RABBITMQ_GENERATE_QUEUE=storyboard.generate.request
RABBITMQ_REGENERATE_QUEUE=storyboard.regenerate.request
RABBITMQ_GENERATE_ROUTING_KEY=storyboard.generate
RABBITMQ_REGENERATE_ROUTING_KEY=storyboard.regenerate
RABBITMQ_GENERATE_COMPLETED_ROUTING_KEY=storyboard.generate.completed
RABBITMQ_GENERATE_FAILED_ROUTING_KEY=storyboard.generate.failed
RABBITMQ_REGENERATE_COMPLETED_ROUTING_KEY=storyboard.regenerate.completed
RABBITMQ_REGENERATE_FAILED_ROUTING_KEY=storyboard.regenerate.failed
