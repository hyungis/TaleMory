# dev 환경 app 스택용 env 예시 (실제 파일은 CI가 /tmp/env/app.dev.env 로 생성)
# GitLab Variables prefix:
#   ENV_BASE_*              → 모든 env 공통
#   ENV_DEV_BACKEND_*       → backend용, app.dev.env 에 합쳐짐
#   ENV_DEV_FRONTEND_*      → frontend(nginx)용, app.dev.env 에 합쳐짐
#   ENV_DEV_AI_*            → ai용, app.dev.env 에 합쳐짐

# Compose
COMPOSE_PROJECT_NAME=s210-app-dev

# Backend (Spring)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:mysql://dev-mysql:3306/iportfolio?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=app
DB_PASSWORD=<secret>

# Redis
REDIS_HOST=dev-redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=dev-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<secret>
RABBITMQ_PASSWORD=<secret>

# Frontend (nginx publish port)
FRONTEND_PORT=3001
VITE_API_BASE_URL=/api

# AI
OPENAI_API_KEY=<secret>
