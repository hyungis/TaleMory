# 로컬 개발용 infra 스택(mysql/redis/rabbitmq) env 예시.
#
# 사용:
#   cp infra/env/infra.local.env.example infra/env/infra.local.env
#   (infra.local.env 편집)
#
# compose가 `env_file: ../env/infra.local.env`로 해당 컨테이너에 주입.

# ─── MySQL ─────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=iportfolio
MYSQL_USER=app
MYSQL_PASSWORD=apppass

# ─── Redis ─────────────────────────────────────────────────────
# (redis-server의 --requirepass가 이 값을 읽음)
REDIS_PASSWORD=redispass

# ─── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbitpass

# OAuth/Kakao vars are app-scoped. Keep FRONTEND_OAUTH_* and KAKAO_* in app.local.env(.example).
