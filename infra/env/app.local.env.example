# 로컬 개발용 app 스택(backend/ai-worker/nginx) env 예시.
# (ai(FastAPI)는 컨테이너로 기동하지 않음 — 필요 시 `cd app/ai && uvicorn main:app --reload` 로 직접 실행.)
#
# 사용:
#   cp infra/env/app.local.env.example infra/env/app.local.env
#   (app.local.env 편집)
#
# compose가 `env_file: ../env/app.local.env`로 각 서비스에 주입.
# ⚠️ infra.local.env의 값(MYSQL_PASSWORD, REDIS_PASSWORD, RABBITMQ_DEFAULT_*)과 **반드시 일치**해야 연결됨.

# ─── Backend (Spring) ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
# compose 내부망에선 서비스명 `mysql`로 접근. 포트는 내부 3306.
DB_URL=jdbc:mysql://mysql:3306/iportfolio?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=app
DB_PASSWORD=apppass

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbit
RABBITMQ_PASSWORD=rabbitpass

# JWT — 로컬 개발용 더미 값. 운영에선 반드시 GitLab Variables의 안전한 값으로 override.
JWT_ACCESS_SECRET=local-access-secret-change-me-at-least-32chars
JWT_REFRESH_SECRET=local-refresh-secret-change-me-at-least-32chars

# OAuth (Kakao)
FRONTEND_OAUTH_CALLBACK_URI=http://localhost:3001/auth/oauth/callback
FRONTEND_OAUTH_LOGOUT_CALLBACK_URI=http://localhost:3001/auth/logout/callback
KAKAO_CLIENT_ID=kakao-rest-api-key-change-me
KAKAO_CLIENT_SECRET=kakao-client-secret-change-me
KAKAO_REDIRECT_URI=http://localhost:3001/api/auth/oauth/kakao/callback
KAKAO_LOGOUT_REDIRECT_URI=http://localhost:3001/api/auth/oauth/kakao/logout/callback

# ─── AI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-dummy-local
PROJECT_NAME=S210 AI API
APP_VERSION=0.1.0
ENVIRONMENT=local
STORYBOARD_MODEL=gpt-4o-mini
STORYBOARD_INPUT_COST_PER_1M=0.15
STORYBOARD_OUTPUT_COST_PER_1M=0.60
RABBITMQ_VHOST=/
RABBITMQ_REQUEST_EXCHANGE=storyboard.request
RABBITMQ_RESULT_EXCHANGE=storyboard.result
RABBITMQ_GENERATE_QUEUE=storyboard.generate.request
RABBITMQ_REGENERATE_QUEUE=storyboard.regenerate.request
RABBITMQ_GENERATE_ROUTING_KEY=storyboard.generate
RABBITMQ_REGENERATE_ROUTING_KEY=storyboard.regenerate
RABBITMQ_GENERATE_COMPLETED_ROUTING_KEY=storyboard.generate.completed
RABBITMQ_GENERATE_FAILED_ROUTING_KEY=storyboard.generate.failed
RABBITMQ_REGENERATE_COMPLETED_ROUTING_KEY=storyboard.regenerate.completed
RABBITMQ_REGENERATE_FAILED_ROUTING_KEY=storyboard.regenerate.failed

# ai-worker 복제본 수. compose `scale:` 키로 적용. 1이면 단일 컨테이너.
AI_WORKER_REPLICAS=1

# ─── AWS S3 ────────────────────────────────────────────────────
# 로컬 개발 시 본인의 s210-backend-s3 IAM user access key 로 override (app.local.env).
# example 값은 template placeholder — 실제 S3 호출은 실패함.
AWS_ACCESS_KEY_ID=AKIA-DUMMY-LOCAL
AWS_SECRET_ACCESS_KEY=dummy-secret-local-replace-me
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=s210-iportfolio-dev

# ─── Frontend / Nginx ──────────────────────────────────────────
VITE_API_BASE_URL=/api
