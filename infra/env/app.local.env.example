# 로컬 개발용 app 스택(backend/ai-worker/nginx) env 예시.
# (ai(FastAPI)는 컨테이너로 기동하지 않음 — 필요 시 `cd app/ai && uvicorn main:app --reload` 로 직접 실행.)
#
# 사용:
#   cp infra/env/app.local.env.example infra/env/app.local.env
#   (app.local.env 편집)
#
# compose가 `env_file: ../env/app.local.env`로 각 서비스에 주입.
# ⚠️ infra.local.env의 값(MYSQL_PASSWORD, REDIS_PASSWORD, RABBITMQ_DEFAULT_*)과 **반드시 일치**해야 연결됨.

# ─── Backend (Spring) ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker
# compose 내부망에선 서비스명 `mysql`로 접근. 포트는 내부 3306.
DB_URL=jdbc:mysql://mysql:3306/iportfolio?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=app
DB_PASSWORD=apppass

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbit
RABBITMQ_PASSWORD=rabbitpass

# JWT — 로컬 개발용 더미 값. 운영에선 반드시 GitLab Variables의 안전한 값으로 override.
JWT_ACCESS_SECRET=local-access-secret-change-me-at-least-32chars
JWT_REFRESH_SECRET=local-refresh-secret-change-me-at-least-32chars

# OAuth (Kakao)
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3001/auth/kakao/callback,http://talemory.site:3001/auth/kakao/callback,https://talemory.site:3443/auth/kakao/callback,https://talemory.site/auth/kakao/callback
KAKAO_CLIENT_ID=kakao-rest-api-key-change-me
KAKAO_CLIENT_SECRET=kakao-client-secret-change-me

# Mail (email verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=gmail-account@example.com
MAIL_PASSWORD=gmail-app-password-change-me
MAIL_FROM=gmail-account@example.com
MAIL_FROM_NAME=Talemory
EMAIL_VERIFICATION_CODE_TTL_SECONDS=300
EMAIL_VERIFICATION_VERIFIED_TTL_SECONDS=1800

# ─── AI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-dummy-local
REPLICATE_API_TOKEN=r8-dummy-local
TTS_ENGINE=qwen
COSYVOICE_BASE_URL=http://desktop-6mrtl1b:8001

COSYVOICE_INSTRUCT_PATH=/inference_instruct2
COSYVOICE_CROSS_LINGUAL_PATH=/inference_cross_lingual
COSYVOICE_ZERO_SHOT_PATH=/inference_zero_shot
COSYVOICE_TIMEOUT_SEC=60
QWEN_TTS_SERVER_URL=http://100.64.201.34:8091
QWEN_TTS_VOICE_CLONE_PATH=/tts/voice-clone
QWEN_TTS_TIMEOUT_SEC=300
QWEN_TTS_X_VECTOR_ONLY_MODE=true
TTS_STORAGE_MODE=local
TTS_PUBLIC_BASE_URL=/static
TTS_DEFAULT_LANGUAGE=ko-KR
TTS_STORAGE_ROOT=/app/.runtime/storage
TTS_MANIFEST_ROOT=/app/.runtime/manifests

# Gemini (storyboard 이미지 생성용). 비워두면 이미지 생성 호출 실패.
GEMINI_API_KEY=
PROJECT_NAME=S210 AI API
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO
STORYBOARD_MODEL=gpt-4o-mini
WEBTOON_STORYBOARD_MODEL=gpt-4o-mini
STORYBOARD_INPUT_COST_PER_1M=0.15
STORYBOARD_OUTPUT_COST_PER_1M=0.60

# Storyboard summary generation
STORYBOARD_SUMMARY_MODEL=gpt-5-nano
STORYBOARD_SUMMARY_REASONING_EFFORT=high
STORYBOARD_SUMMARY_INPUT_COST_PER_1M=0.05
STORYBOARD_SUMMARY_OUTPUT_COST_PER_1M=0.40

# Storyboard 이미지 생성
# 버킷/리전/IAM은 백엔드와 동일하게 AWS_S3_BUCKET / AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 재사용.
STORYBOARD_IMAGE_MODEL=gemini-2.5-flash-image
WEBTOON_STORYBOARD_IMAGE_MODEL=gemini-2.5-flash-image
STORYBOARD_IMAGE_INPUT_COST_PER_1M=0.30
STORYBOARD_IMAGE_OUTPUT_COST_PER_IMAGE=0.039
STORYBOARD_IMAGE_PUBLIC_BASE_URL=
STORYBOARD_IMAGE_S3_ENDPOINT_URL=
STORYBOARD_IMAGE_S3_ACCESS_KEY_ID=
STORYBOARD_IMAGE_S3_SECRET_ACCESS_KEY=
STORYBOARD_IMAGE_S3_REGION=ap-northeast-2
STORYBOARD_IMAGE_S3_BUCKET=s210-iportfolio-dev

RABBITMQ_VHOST=/
AI_WORKER_CONCURRENCY=2
AI_STORY_API_CONCURRENCY=3
AI_IMAGE_API_CONCURRENCY=20
AI_GEMINI_IMAGE_API_CONCURRENCY=20
AI_REPLICATE_IMAGE_API_CONCURRENCY=5
AI_LAYOUT_API_CONCURRENCY=20
RABBITMQ_PREFETCH_COUNT=20
RABBITMQ_REQUEST_EXCHANGE=ai.request
RABBITMQ_RESULT_EXCHANGE=ai.result
RABBITMQ_GENERATE_QUEUE=ai.cpu.story.generate.request.queue
RABBITMQ_REGENERATE_QUEUE=ai.cpu.story.regenerate.request.queue
RABBITMQ_GENERATE_ROUTING_KEY=ai.cpu.story.generate
RABBITMQ_REGENERATE_ROUTING_KEY=ai.cpu.story.regenerate
RABBITMQ_GENERATE_COMPLETED_ROUTING_KEY=ai.result.story.generate.completed
RABBITMQ_GENERATE_FAILED_ROUTING_KEY=ai.result.story.generate.failed
RABBITMQ_REGENERATE_COMPLETED_ROUTING_KEY=ai.result.story.regenerate.completed
RABBITMQ_REGENERATE_FAILED_ROUTING_KEY=ai.result.story.regenerate.failed
RABBITMQ_SENTENCE_TRANSLATE_QUEUE=ai.cpu.story.sentences.translate.request.queue
RABBITMQ_SENTENCE_TRANSLATE_ROUTING_KEY=ai.cpu.story.sentences.translate
RABBITMQ_SENTENCE_TRANSLATE_COMPLETED_ROUTING_KEY=ai.result.story.sentences.translate.completed
RABBITMQ_SENTENCE_TRANSLATE_FAILED_ROUTING_KEY=ai.result.story.sentences.translate.failed
RABBITMQ_TTS_GENERATE_QUEUE=ai.gpu.request.queue
RABBITMQ_TTS_PREVIEW_QUEUE=ai.gpu.preview.request.queue
RABBITMQ_TTS_GENERATE_ROUTING_KEY=ai.gpu.tts.generate
RABBITMQ_TTS_PREVIEW_ROUTING_KEY=ai.gpu.tts.preview
RABBITMQ_TTS_GENERATE_COMPLETED_ROUTING_KEY=ai.result.tts.generate.completed
RABBITMQ_TTS_GENERATE_FAILED_ROUTING_KEY=ai.result.tts.generate.failed
# Storyboard 이미지 전용 queue/routing
RABBITMQ_IMAGE_GENERATE_QUEUE=ai.image.generate.request.queue
RABBITMQ_IMAGE_GENERATE_ITEM_QUEUE=ai.image.generate.item.request.queue
RABBITMQ_IMAGE_REGENERATE_QUEUE=ai.image.regenerate.request.queue
RABBITMQ_IMAGE_GENERATE_ROUTING_KEY=ai.image.generate
RABBITMQ_IMAGE_GENERATE_ITEM_ROUTING_KEY=ai.image.generate.item
RABBITMQ_IMAGE_REGENERATE_ROUTING_KEY=ai.image.regenerate
RABBITMQ_IMAGE_GENERATE_COMPLETED_ROUTING_KEY=ai.result.image.generate.completed
RABBITMQ_IMAGE_GENERATE_FAILED_ROUTING_KEY=ai.result.image.generate.failed
RABBITMQ_IMAGE_REGENERATE_COMPLETED_ROUTING_KEY=ai.result.image.regenerate.completed
RABBITMQ_IMAGE_REGENERATE_FAILED_ROUTING_KEY=ai.result.image.regenerate.failed

# ai-worker 복제본 수. compose `scale:` 키로 적용. 1이면 단일 컨테이너.
FINAL_ILLUSTRATION_MODEL=black-forest-labs/flux-2-klein-9b

# WEBTOON 좌표 추출 Gemini Vision 모델. 비워두면 코드 default("gemini-3-flash-preview").
# GEMINI_API_KEY 가 비어있으면 좌표 추출 단계가 실패한다 — WEBTOON 모드 테스트엔 필수.
FINAL_ILLUSTRATION_LAYOUT_MODEL=gemini-3-flash-preview
RABBITMQ_FINAL_ILLUSTRATION_GENERATE_QUEUE=ai.final-illustration.generate.request.queue
RABBITMQ_FINAL_ILLUSTRATION_GENERATE_ITEM_QUEUE=ai.final-illustration.generate.item.request.queue
RABBITMQ_FINAL_ILLUSTRATION_REVISE_QUEUE=ai.final-illustration.revise.request.queue
RABBITMQ_FINAL_ILLUSTRATION_LAYOUT_QUEUE=ai.final-illustration.layout.request.queue
RABBITMQ_FINAL_ILLUSTRATION_LAYOUT_ITEM_QUEUE=ai.final-illustration.layout.item.request.queue
RABBITMQ_FINAL_ILLUSTRATION_GENERATE_ROUTING_KEY=ai.image.final-illustration.generate
RABBITMQ_FINAL_ILLUSTRATION_GENERATE_ITEM_ROUTING_KEY=ai.image.final-illustration.generate.item
RABBITMQ_FINAL_ILLUSTRATION_REVISE_ROUTING_KEY=ai.image.final-illustration.revise
RABBITMQ_FINAL_ILLUSTRATION_LAYOUT_ROUTING_KEY=ai.image.final-illustration.layout
RABBITMQ_FINAL_ILLUSTRATION_LAYOUT_ITEM_ROUTING_KEY=ai.image.final-illustration.layout.item
RABBITMQ_FINAL_ILLUSTRATION_GENERATE_COMPLETED_ROUTING_KEY=ai.result.final-illustration.generate.completed
RABBITMQ_FINAL_ILLUSTRATION_GENERATE_FAILED_ROUTING_KEY=ai.result.final-illustration.generate.failed
RABBITMQ_FINAL_ILLUSTRATION_REVISE_COMPLETED_ROUTING_KEY=ai.result.final-illustration.revise.completed
RABBITMQ_FINAL_ILLUSTRATION_REVISE_FAILED_ROUTING_KEY=ai.result.final-illustration.revise.failed
RABBITMQ_FINAL_ILLUSTRATION_LAYOUT_COMPLETED_ROUTING_KEY=ai.result.final-illustration.layout.completed
RABBITMQ_FINAL_ILLUSTRATION_LAYOUT_FAILED_ROUTING_KEY=ai.result.final-illustration.layout.failed
AI_WORKER_REPLICAS=1
AI_TTS_STORY_WORKER_REPLICAS=1
AI_TTS_PREVIEW_WORKER_REPLICAS=1

# ─── AWS S3 ────────────────────────────────────────────────────
# 로컬 개발 시 본인의 s210-backend-s3 IAM user access key 로 override (app.local.env).
# example 값은 template placeholder — 실제 S3 호출은 실패함.
AWS_ACCESS_KEY_ID=AKIA-DUMMY-LOCAL
AWS_SECRET_ACCESS_KEY=dummy-secret-local-replace-me
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=s210-iportfolio-dev
# 환경별 root prefix (local/dev/prod). BE/AI 워커가 모든 S3 key 앞에 prepend.
# AI 워커 TTS 는 최종적으로 `{AWS_S3_ENV_PREFIX}/{AWS_S3_PREFIX}/...` 형식으로 키를 만든다.
AWS_S3_ENV_PREFIX=local
AWS_S3_PREFIX=stories/tts
AWS_S3_PUBLIC_BASE_URL=

# ─── Frontend / Nginx ──────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_KAKAO_CLIENT_ID=kakao-rest-api-key-change-me
VITE_TTS_API_BASE=http://127.0.0.1:8000
VITE_VIEWER_USE_MOCK=false

# ─── Sqids ID 토큰 인코더 ───────────────────────────────────────
# 외부 노출 ID 의 Sqids 인코딩 설정. alphabet 은 비밀 (운영은 GitLab CI variable 로 override).
# 로컬은 application-example.yml 의 default alphabet 으로 떨어지므로 비워둬도 됨.
# 디버깅 시 APP_ID_CODEC_LOG=true 로 인코딩/디코딩 변환 INFO 로그 활성.
APP_ID_CODEC_ALPHABET=
APP_ID_CODEC_MIN_LENGTH=8
APP_ID_CODEC_LOG=false

