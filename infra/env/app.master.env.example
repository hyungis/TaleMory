# master(운영) 환경 app 스택용 env 예시
# GitLab Variables prefix:
#   ENV_BASE_*              → 공통
#   ENV_MASTER_BACKEND_*    → backend용
#   ENV_MASTER_FRONTEND_*   → frontend(nginx)용
#   ENV_MASTER_AI_*         → ai용

COMPOSE_PROJECT_NAME=s210-app-master

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_URL=jdbc:mysql://prod-mysql:3306/iportfolio?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=app
DB_PASSWORD=<secret>

REDIS_HOST=prod-redis
REDIS_PORT=6379

RABBITMQ_HOST=prod-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<secret>
RABBITMQ_PASSWORD=<secret>

FRONTEND_PORT=80
VITE_API_BASE_URL=/api

OPENAI_API_KEY=<secret>
