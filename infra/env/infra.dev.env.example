# dev 환경 base 인프라(mysql/redis/rabbitmq) 예시
# GitLab Variables prefix:
#   ENV_BASE_*          → 공통
#   ENV_DEV_INFRA_*     → infra.dev.env 에만

COMPOSE_PROJECT_NAME=s210-infra-dev

# MySQL
MYSQL_ROOT_PASSWORD=<secret>
MYSQL_DATABASE=iportfolio
MYSQL_USER=app
MYSQL_PASSWORD=<secret>
MYSQL_PORT=3307

# Redis
REDIS_PORT=6380

# RabbitMQ
RABBITMQ_DEFAULT_USER=<secret>
RABBITMQ_DEFAULT_PASS=<secret>
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
