# master 환경 base 인프라(mysql/redis/rabbitmq) 예시
# GitLab Variables prefix:
#   ENV_BASE_*          → 공통
#   ENV_MASTER_INFRA_*  → infra.master.env 에만

COMPOSE_PROJECT_NAME=s210-infra-master

MYSQL_ROOT_PASSWORD=<secret>
MYSQL_DATABASE=iportfolio
MYSQL_USER=app
MYSQL_PASSWORD=<secret>
MYSQL_PORT=3306

REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=<secret>
RABBITMQ_DEFAULT_PASS=<secret>
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
